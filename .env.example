# ─────────────────────────────────────────────────────────────────
# Strikewise — Environment Variables
# Copy this file to .env.local for local development.
# Set these in Railway → your service → Variables.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── API endpoint ──────────────────────────────────────────────────
# Frontend uses live API by default.
# Leave unset for same-origin deployments where frontend and backend share a host.
# Set for split deployments (frontend and backend on different domains).
# VITE_API_URL=https://your-backend-domain.up.railway.app

# Optional: force local demo mode.
# VITE_FORCE_DEMO=1

# ── App config ────────────────────────────────────────────────────
VITE_APP_NAME=Strikewise
VITE_APP_ENV=development

# Optional Carto basemap key. Leave unset to use the public basemap tiles.
# If you have a Carto API key in Railway, set it here and the app will append
# ?api_key=... to the basemap URLs automatically.
# VITE_CARTO_API_KEY=your_carto_key_here

# Map style: leave unset for the free Esri dark map (no key). Set to 'carto' to use CARTO with VITE_CARTO_API_KEY.
VITE_BASEMAP=
