# ─────────────────────────────────────────────────────────────────
# Strikewise — Environment Variables
# Copy this file to .env.local for local development.
# Set these in Railway → your service → Variables.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── API endpoint ──────────────────────────────────────────────────
# Frontend uses live API by default.
# Leave unset for same-origin deployments where frontend and backend share a host.
# Set for split deployments (frontend and backend on different domains).
# VITE_API_URL=https://your-backend-domain.up.railway.app

# Optional: force local demo mode.
# VITE_FORCE_DEMO=1

# ── App config ────────────────────────────────────────────────────
VITE_APP_NAME=Strikewise
VITE_APP_ENV=development
