# Strikewise backend
NODE_ENV=development
PORT=3000
# Provider options: auto | xweather | blitzortung | open-meteo | tomorrow | noaa-glm | mock
# Recommended default: auto (xweather if configured, then blitzortung, then open-meteo)
LIGHTNING_PROVIDER=auto
CORS_ORIGIN=*

# xWeather commercial provider
# LIGHTNING_PROVIDER=xweather
# XWEATHER_CLIENT_ID=your_client_id
# XWEATHER_CLIENT_SECRET=your_client_secret

# Tomorrow.io provider
# LIGHTNING_PROVIDER=tomorrow
# TOMORROW_API_KEY=your_tomorrow_api_key

# Optional ML risk service proxy
ML_SERVICE_URL=http://localhost:5000
ML_REQUEST_TIMEOUT_MS=8000

# NOAA GOES GLM public bucket config
# Note: noaa-glm provider is currently experimental and does not parse full strike data yet.
NOAA_GLM_BUCKET=noaa-goes18
NOAA_GLM_BASE_URL=https://noaa-goes18.s3.amazonaws.com
NOAA_GLM_PRODUCT=GLM-L2-LCFA
NOAA_GLM_POLL_SECONDS=15
